generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  AVAILABLE
  SOLD
  RESERVED
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
  AMT
  CVT
  DCT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  phone        String?
  role         UserRole     @default(USER)

  favourites   Favourite[]
  enquiries    Enquiry[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  logoUrl   String?

  models    Model[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Model {
  id        Int      @id @default(autoincrement())
  name      String
  bodyType  String?

  brandId   Int
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  listings  Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, name])
}

model Listing {
  id                Int            @id @default(autoincrement())

  modelId           Int
  model             Model          @relation(fields: [modelId], references: [id])

  variant           String
  year              Int
  price             Decimal        @db.Decimal(12, 2)
  kmDriven          Int

  fuelType          FuelType
  transmission      Transmission

  ownerCount        Int?
  color             String?
  registrationCity  String?
  registrationNumber String?

  engine            String?
  mileage           String?
  seatingCapacity   Int?
  description       String?

  status            ListingStatus  @default(AVAILABLE)

  images            CarImage[]
  features          ListingFeature[]
  favourites        Favourite[]
  enquiries         Enquiry[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([modelId])
  @@index([price])
  @@index([year])
  @@index([fuelType])
  @@index([transmission])
  @@index([status])
}

model CarImage {
  id         Int      @id @default(autoincrement())
  imageUrl   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)

  listingId  Int
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([listingId])
}

model Feature {
  id          Int              @id @default(autoincrement())
  name        String           @unique

  listings    ListingFeature[]

  createdAt   DateTime         @default(now())
}

model ListingFeature {
  listingId   Int
  featureId   Int

  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  feature     Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([listingId, featureId])
}

model Favourite {
  id         Int      @id @default(autoincrement())

  userId     Int
  listingId  Int

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Enquiry {
  id         Int           @id @default(autoincrement())

  userId     Int
  listingId  Int

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  message    String?
  status     EnquiryStatus @default(NEW)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([status])
}